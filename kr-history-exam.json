{
  "schemaVersion": 1,
  "id": "kr-history-exam",
  "name": "한국사능력검정시험",
  "unofficial": ["headMm", "background"],
  "audience": "adult",
  "photoMm": [30, 40],
  "headMm": { "min": 28, "max": 32, "target": 30 },
  "topMarginMm": 4,
  "background": { "kind": "light", "minLuma": 170, "maxStd": 25 },
  "expression": { "mouthOpen": false, "smile": false, "eyesOpen": true },
  "checks": {
    "faceCount": true,
    "headLength": true,
    "resolution": true,
    "sharpness": true,
    "tilt": true,
    "expression": true,
    "background": true,
    "shadow": true,
    "manual": ["crownLine", "glasses", "noHat", "takenWithin6Months"]
  },
  "digital": {
    "px": [120, 160],
    "wRange": [120, 120],
    "hRange": [160, 160],
    "format": "jpeg",
    "accept": ["jpeg", "gif"],
    "maxKB": 200,
    "dpi": 102,
    "unofficial": ["range", "maxKB", "dpi"]
  },
  "print": { "sheetIn": [6, 4], "sheetPx": [1800, 1200], "cols": 4, "rows": 2, "cutLines": true },
  "allowedFixes": { "rotate": { "maxDeg": 6 } },
  "presentation": {
    "nextSteps": "examUpload"
  },
  "notes": {
    "ko": "제81회 응시요강 기준 6개월 이내에 촬영한 컬러 상반신 정면 사진을 올려 주세요. 모자와 배경이 없어야 하고 얼굴은 사진의 1/3 이상이어야 해요. 3MB 이하 권장 용량이에요. 자주 묻는 질문은 GIF·JPG와 120×160px 권장 크기를 안내해요. 사진패스는 200KB 이하(사진패스 권장) JPG로 만들어요. 머리 길이 28~32mm와 밝은 단색 배경은 사진패스가 정한 출력 기준이에요."
  },
  "source": "https://www.historyexam.go.kr/pst/view.do?bbs=noti&pst_sno=1000030164",
  "checkedAt": "2026-11-26"
}
