{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sajinpass.com/specs/schema.json",
  "title": "사진패스 증명사진 규격",
  "description": "증명사진 규격 한 가지를 나타낸다. 규정 원문이 기준이며 이 데이터는 참고용이다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "audience",
    "photoMm",
    "headMm",
    "topMarginMm",
    "background",
    "expression",
    "checks",
    "digital",
    "print",
    "notes",
    "source",
    "checkedAt"
  ],
  "properties": {
    "schemaVersion": {
      "description": "스키마 버전. 앱은 모르는 버전이면 내장 사본을 쓴다.",
      "const": 1
    },
    "id": {
      "description": "규격 식별자이자 파일 이름(확장자 제외).",
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9-]+$"
    },
    "name": { "description": "화면에 보이는 규격 이름.", "type": "string", "minLength": 1 },
    "audience": { "description": "대상. 영유아 규격은 입 벌림 점검을 건너뛴다.", "enum": ["adult", "infant"] },
    "photoMm": { "description": "사진 크기 [가로, 세로] mm.", "$ref": "#/$defs/positivePair" },
    "headMm": {
      "description": "턱 끝에서 정수리까지 길이(mm). target은 자르기 배율을 정한다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "target"],
      "properties": {
        "min": { "type": "number", "exclusiveMinimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "target": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "topMarginMm": {
      "description": "정수리에서 사진 위 가장자리까지 거리(mm).",
      "type": "number",
      "minimum": 0
    },
    "background": {
      "description": "배경 점검 기준. 밝기는 0~255.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "minLuma", "maxStd"],
      "properties": {
        "kind": { "enum": ["white", "light"] },
        "minLuma": { "type": "number", "minimum": 0, "maximum": 255 },
        "maxStd": { "type": "number", "minimum": 0, "maximum": 255 }
      }
    },
    "expression": {
      "description": "표정 요구 사항.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mouthOpen", "smile", "eyesOpen"],
      "properties": {
        "mouthOpen": { "description": "입 벌림 허용 여부.", "type": "boolean" },
        "smile": { "description": "미소 허용 여부.", "type": "boolean" },
        "eyesOpen": { "description": "눈을 떠야 하는지 여부.", "type": "boolean" }
      }
    },
    "checks": {
      "description": "켜고 끄는 자동 점검과 본인 확인 항목.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faceCount",
        "headLength",
        "resolution",
        "sharpness",
        "tilt",
        "expression",
        "background",
        "shadow",
        "manual"
      ],
      "properties": {
        "faceCount": { "type": "boolean" },
        "headLength": { "type": "boolean" },
        "resolution": { "type": "boolean" },
        "sharpness": { "type": "boolean" },
        "tilt": { "type": "boolean" },
        "expression": { "type": "boolean" },
        "background": { "type": "boolean" },
        "shadow": { "type": "boolean" },
        "manual": {
          "description": "사용자가 직접 확인하는 항목.",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["crownLine", "glasses", "lenses", "takenWithin6Months"] }
        }
      }
    },
    "digital": {
      "description": "온라인 제출 파일 규격.",
      "type": "object",
      "additionalProperties": false,
      "required": ["px", "wRange", "hRange", "format", "maxKB", "dpi"],
      "properties": {
        "px": { "description": "내보내는 크기 [가로, 세로] px.", "$ref": "#/$defs/positiveIntPair" },
        "wRange": { "description": "허용 가로 범위 [최소, 최대] px.", "$ref": "#/$defs/positiveIntPair" },
        "hRange": { "description": "허용 세로 범위 [최소, 최대] px.", "$ref": "#/$defs/positiveIntPair" },
        "format": { "enum": ["jpeg"] },
        "maxKB": { "type": "integer", "exclusiveMinimum": 0 },
        "dpi": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "print": {
      "description": "인화 배치. sheetPx는 300dpi 기준.",
      "type": "object",
      "additionalProperties": false,
      "required": ["sheetIn", "sheetPx", "cols", "rows", "cutLines"],
      "properties": {
        "sheetIn": { "description": "인화지 크기 [가로, 세로] inch.", "$ref": "#/$defs/positivePair" },
        "sheetPx": { "description": "인화지 크기 [가로, 세로] px.", "$ref": "#/$defs/positiveIntPair" },
        "cols": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "cutLines": { "type": "boolean" }
      }
    },
    "notes": {
      "description": "언어별 한 줄 요약.",
      "type": "object",
      "required": ["ko"],
      "propertyNames": { "pattern": "^[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "source": { "description": "규정 원문 링크.", "type": "string", "pattern": "^https://" },
    "sourceDigital": { "description": "전자 제출 규정 원문 링크.", "type": "string", "pattern": "^https://" },
    "checkedAt": {
      "description": "원문을 마지막으로 확인한 날짜(YYYY-MM-DD).",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "$defs": {
    "positivePair": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "items": false,
      "minItems": 2
    },
    "positiveIntPair": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "exclusiveMinimum": 0 },
        { "type": "integer", "exclusiveMinimum": 0 }
      ],
      "items": false,
      "minItems": 2
    }
  }
}
