{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sajinpass.com/specs/schema.json",
  "title": "사진패스 증명사진 규격",
  "description": "증명사진 규격 한 가지를 나타낸다. 규정 원문이 기준이며 이 데이터는 참고용이다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "audience",
    "photoMm",
    "headMm",
    "topMarginMm",
    "background",
    "expression",
    "checks",
    "digital",
    "print",
    "notes",
    "checkedAt"
  ],
  "properties": {
    "schemaVersion": {
      "description": "스키마 버전. 앱은 모르는 버전이면 내장 사본을 쓴다.",
      "const": 1
    },
    "id": {
      "description": "규격 식별자이자 파일 이름(확장자 제외).",
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9-]+$"
    },
    "name": {
      "description": "화면에 보이는 규격 이름.",
      "type": "string",
      "minLength": 1
    },
    "official": {
      "description": "공식 규정이 있는 규격이면 true(기본). false면 발급 기관 규정이 없고 흔히 쓰는 크기를 담은 관습 규격이며, source를 생략할 수 있다.",
      "type": "boolean"
    },
    "unofficial": {
      "description": "공식 원문에 없어 사진패스가 정한 값. photoMm은 사진 크기, headMm은 머리 길이, background는 배경색이다. 화면에는 '사진패스 권장'으로 표시한다. 파일 픽셀·용량은 digital.unofficial에 적는다.",
      "type": "array",
      "items": {
        "enum": [
          "photoMm",
          "headMm",
          "background"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "audience": {
      "description": "대상. 영유아 규격은 입 벌림 점검을 건너뛴다.",
      "enum": [
        "adult",
        "infant"
      ]
    },
    "photoMm": {
      "description": "사진 크기 [가로, 세로] mm.",
      "$ref": "#/$defs/positivePair"
    },
    "headMm": {
      "description": "턱 끝에서 머리 꼭대기(headTop)까지 길이(mm). target은 자르기 배율을 정한다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "target"
      ],
      "properties": {
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "target": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "headTop": {
      "description": "머리 길이를 재는 위쪽 끝. crown(기본)은 머리카락을 뺀 정수리, hair는 머리카락 끝이다(미국 비자처럼 머리카락까지 재는 규격).",
      "enum": [
        "crown",
        "hair"
      ]
    },
    "topMarginMm": {
      "description": "머리 꼭대기(headTop)에서 사진 위 가장자리까지 거리(mm).",
      "type": "number",
      "minimum": 0
    },
    "faceWidthMm": {
      "description": "종이 사진의 얼굴 폭(양 볼 바깥선 사이, mm). 원문에 있는 규격만 둔다. 자를 때 이 안에 들게 머리 길이를 고르고 얼굴 배치 점검이 본다.",
      "$ref": "#/$defs/positivePair"
    },
    "background": {
      "description": "배경 점검 기준. 밝기는 0~255.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "minLuma",
        "maxStd"
      ],
      "properties": {
        "kind": {
          "enum": [
            "white",
            "light"
          ]
        },
        "minLuma": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "maxStd": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "expression": {
      "description": "표정 요구 사항.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mouthOpen",
        "smile",
        "eyesOpen"
      ],
      "properties": {
        "mouthOpen": {
          "description": "입 벌림 허용 여부.",
          "type": "boolean"
        },
        "smile": {
          "description": "미소 허용 여부.",
          "type": "boolean"
        },
        "eyesOpen": {
          "description": "눈을 떠야 하는지 여부.",
          "type": "boolean"
        },
        "closedEyesUnderOne": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "description": "켜고 끄는 자동 점검과 본인 확인 항목.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faceCount",
        "headLength",
        "resolution",
        "sharpness",
        "tilt",
        "expression",
        "background",
        "shadow",
        "manual"
      ],
      "properties": {
        "faceCount": {
          "type": "boolean"
        },
        "headLength": {
          "description": "파일 검사기에서 머리 길이를 재어 판정하는지. false여도 자르기 목표는 headMm.target을 쓴다.",
          "type": "boolean"
        },
        "resolution": {
          "type": "boolean"
        },
        "sharpness": {
          "type": "boolean"
        },
        "tilt": {
          "type": "boolean"
        },
        "expression": {
          "type": "boolean"
        },
        "background": {
          "type": "boolean"
        },
        "shadow": {
          "type": "boolean"
        },
        "manual": {
          "description": "사용자가 직접 확인하는 항목.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "crownLine",
              "hairLine",
              "aloneInPhoto",
              "glasses",
              "noGlasses",
              "lenses",
              "takenWithin6Months",
              "noHat",
              "faceOutline",
              "eyebrows",
              "eyesUncovered",
              "earsVisible",
              "scan300ppi",
              "scan600ppi",
              "hairContrast"
            ]
          }
        }
      }
    },
    "digital": {
      "description": "온라인 제출 파일 규격.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "px",
        "wRange",
        "hRange",
        "format",
        "maxKB",
        "dpi"
      ],
      "properties": {
        "px": {
          "description": "내보내는 크기 [가로, 세로] px.",
          "$ref": "#/$defs/positiveIntPair"
        },
        "wRange": {
          "description": "허용 가로 범위 [최소, 최대] px.",
          "$ref": "#/$defs/positiveIntPair"
        },
        "hRange": {
          "description": "허용 세로 범위 [최소, 최대] px.",
          "$ref": "#/$defs/positiveIntPair"
        },
        "format": {
          "enum": [
            "jpeg"
          ]
        },
        "accept": {
          "description": "제출처가 받는 파일 형식. 없으면 format만 받는다. 사진패스가 만드는 파일은 늘 format이다.",
          "type": "array",
          "items": {
            "enum": [
              "jpeg",
              "png",
              "gif",
              "jp2",
              "bmp",
              "heic"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "jpeg"
          }
        },
        "sRGB": { "type": "boolean" },
        "regularVisaMaxKB": { "type": "integer", "minimum": 1 },
        "recommendedMaxKB": { "type": "integer", "minimum": 1 },
        "maxKB": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "frameMm": {
          "description": "파일이 담는 범위 [가로, 세로] mm. 파일 비율이 종이 사진(photoMm)과 다른 규격만 둔다. 높이는 photoMm과 같고 가로는 같거나 넓다. 인화는 가운데를 photoMm 비율로 잘라 쓴다.",
          "$ref": "#/$defs/positivePair"
        },
        "minKB": {
          "description": "제출처가 정한 최소 용량(KB). 없으면 하한이 없다. maxKB보다 작다.",
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "officialMinPx": {
          "description": "허용 범위(wRange·hRange)가 사진패스가 정한 값(unofficial의 range)이어도 원문에 있는 최소 픽셀 [가로, 세로]. 파일 검사기가 이보다 작으면 실패로 본다.",
          "$ref": "#/$defs/positiveIntPair"
        },
        "officialMaxKB": {
          "description": "용량 상한(maxKB)이 사진패스가 정한 값(unofficial의 maxKB)이어도 원문에 있는 더 넉넉한 용량 상한(KB).",
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "officialMaxExclusive": {
          "description": "원문 상한이 미만이면 true. 없으면 이하. officialMaxKB가 있으면 그 상한에 적용하고, 없으면 원문 값인 maxKB에 적용한다.",
          "type": "boolean"
        },
        "layout": {
          "description": "제출처가 파일 픽셀로 정한 얼굴 배치. refPx 크기 파일 기준이고 다른 크기면 가로 비율로 늘린다. faceWidthPx는 얼굴 폭 범위, eyeFromBottomMinPx는 파일 아래 끝에서 눈 가운데 선까지의 최소 거리, eyeDistanceMinPx는 두 눈 사이 최소 거리, crownFromTopPx는 파일 위 끝에서 머리 꼭대기(headTop)까지의 거리 범위.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "refPx",
            "faceWidthPx",
            "eyeFromBottomMinPx",
            "eyeDistanceMinPx",
            "crownFromTopPx"
          ],
          "properties": {
            "refPx": {
              "$ref": "#/$defs/positivePair"
            },
            "faceWidthPx": {
              "$ref": "#/$defs/positivePair"
            },
            "eyeFromBottomMinPx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "eyeDistanceMinPx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "crownFromTopPx": {
              "$ref": "#/$defs/positivePair"
            }
          }
        },
        "dpi": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "unofficial": {
          "description": "공식 원문에 없어 사진패스가 정한 값. px는 만드는 크기, range는 허용 범위(wRange·hRange. 파일 검사기가 벗어나도 officialMinPx보다 작지 않으면 주의로 본다), maxKB는 용량 상한(넘어도 officialMaxKB 이하면 주의로 본다), dpi는 파일에 적는 해상도(파일 검사기가 점검하지 않는다), format은 파일 형식(권장 형식이 아니면 주의로 본다). 없으면 모두 원문 값이다. 화면에는 '사진패스 권장'으로 표시한다.",
          "type": "array",
          "items": {
            "enum": [
              "px",
              "range",
              "maxKB",
              "dpi",
              "format"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "eyeHeightPercent": {
          "description": "사진 아래부터 두 눈 가운데까지의 높이 범위(사진 높이 대비 %).",
          "$ref": "#/$defs/positivePair"
        },
        "maxCompressionRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rgb24": {
          "type": "boolean"
        },
        "preferredRatio": {
          "type": "boolean"
        },
        "officialMinDpi": {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    },
    "print": {
      "description": "인화 배치. sheetPx는 dpi(없으면 300) 기준.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetIn",
        "sheetPx",
        "cols",
        "rows",
        "cutLines"
      ],
      "properties": {
        "sheetIn": {
          "description": "인화지 크기 [가로, 세로] inch.",
          "$ref": "#/$defs/positivePair"
        },
        "sheetPx": {
          "description": "인화지 크기 [가로, 세로] px.",
          "$ref": "#/$defs/positiveIntPair"
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "cutLines": {
          "type": "boolean"
        },
        "dpi": {
          "description": "선택. 인화지 해상도. 없으면 300. 원문이 더 높은 인화 해상도를 요구하면(독일 600dpi) 적는다.",
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "headPercent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      }
    },
    "allowedFixes": {
      "description": "규정 안에서 도구가 자동으로 고쳐도 되는 것. 없으면 자르기·크기 조정·압축만 한다. 배경·밝기·피부는 규격과 상관없이 자동으로 고치지 않는다(배경 단색·밝기는 사용자가 켤 때만 도구가 한다).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rotate": {
          "description": "두 눈을 잇는 선의 기울기가 maxDeg(도) 이하이면 그만큼 돌려 바로 세운 뒤 자른다. 넘으면 고치지 않고 다시 찍기를 안내한다.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxDeg"
          ],
          "properties": {
            "maxDeg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 15
            }
          }
        }
      }
    },
    "poseMaxDeg": {
      "description": "원문이 허용하는 고개 각도(도). 있으면 공통 기준(기울기 6°, 정면 15°)을 넘어도 이 안이면 실패 대신 주의로 둔다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roll",
        "yaw",
        "pitch"
      ],
      "properties": {
        "roll": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "yaw": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pitch": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "allowChildFrontalException": {
      "description": "원문에 어린이의 정면 예외가 있으면 true. 나이를 알 수 없으므로 정면 실패를 주의로 표시한다. 기울기 판정은 그대로 둔다.",
      "type": "boolean"
    },
    "useRules": {
      "description": "제출처 원문에 따른 보정·점검 판정. 기준이 없으면 생략한다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "banned"
      ],
      "properties": {
        "basis": {
          "description": "보정 제한의 근거를 설명하는 화면 문구 키.",
          "enum": [
            "passport",
            "driver",
            "id",
            "suneung",
            "toeic",
            "canada",
            "australia",
            "uk"
          ]
        },
        "banned": {
          "description": "원문에서 금지하는 손질. background는 배경 합성, brightness는 밝기 조절, pad는 사진 바깥을 채우는 배경 합성이다.",
          "type": "array",
          "items": {
            "enum": [
              "background",
              "brightness",
              "pad"
            ]
          },
          "uniqueItems": true
        },
        "strict": {
          "description": "원문에 따라 주의를 실패로 올리는 점검 항목.",
          "type": "array",
          "items": {
            "enum": [
              "faceCount",
              "resolution",
              "placement",
              "eyeHeight",
              "sharpness",
              "tilt",
              "frontal",
              "mouth",
              "smile",
              "eyes",
              "background",
              "shadow",
              "lighting"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "presentation": {
      "description": "규격의 제출 방식이나 예외를 보여 주는 웹 표시 설정. 문구는 사이트의 언어별 메시지에서 읽는다. 없으면 기본 표시를 쓴다.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backgroundText": {
          "description": "whitePreferred는 흰 배경을 권장하고 옅은 단색도 허용하는 안내를 고른다.",
          "enum": [
            "whitePreferred"
          ]
        },
        "photoSizeText": {
          "description": "applicationCenterPrint는 사진 크기를 신청 센터에 내는 인화 규격으로 설명한다.",
          "enum": [
            "applicationCenterPrint"
          ]
        },
        "headLengthText": {
          "description": "onlineVisa는 일반 비자 온라인 머리 길이와 e-Visa 안내를 나눈다. residenceCard는 외국인등록증 수치와 공관 확인 안내를 붙인다.",
          "enum": [
            "onlineVisa",
            "residenceCard"
          ]
        },
        "fileSummary": {
          "description": "workingHoliday는 접수 최소 용량과 권장 상한을 KB로, evisaRecommendation은 전자비자 권장 상한을 MB로 표시한다.",
          "enum": [
            "workingHoliday",
            "evisaRecommendation"
          ]
        },
        "childNotes": {
          "description": "어린이 예외가 있는 원문의 나라별 안내 문구 키. 해당 점검에 별도 안내가 있을 때만 붙인다.",
          "enum": [
            "de",
            "uk",
            "au"
          ]
        },
        "diagram": {
          "description": "규격 치수 그림. onlineVisa는 출력 픽셀을 mm로 바꾼 권장 크기를 그리고 온라인과 인화의 차이를 알린다. residenceCard는 외국인등록증으로 이름을 좁힌다. none은 그림을 만들지 않는다. 없으면 종이 사진 크기로 그린다.",
          "enum": [
            "onlineVisa",
            "residenceCard",
            "none"
          ]
        },
        "gov24Renewal": {
          "description": "true면 결과에 정부24 온라인 재발급 안내를 붙이고, 파일 검사기에서 배경 변경 대신 인화를 먼저 추천한다.",
          "type": "boolean"
        },
        "sizeTableSource": {
          "description": "사이즈 표에서만 먼저 보여 줄 공식 근거 주소. 없으면 source를 쓴다.",
          "type": "string",
          "pattern": "^https://"
        },
        "nextSteps": {
          "description": "한국어 사진 도구 결과에서 추천할 도구와 안내 글 묶음의 키. 없으면 공통 추천을 쓴다.",
          "enum": [
            "consularPrint",
            "examPrint",
            "examUpload",
            "firstPassport",
            "idCardApplication",
            "licenseRenewal",
            "passportRenewal",
            "residenceCardCopy",
            "resumePrint",
            "schengenTravel",
            "travelAuthorization",
            "travelBasics",
            "universityApplication",
            "visaDocuments",
            "visaPrint",
