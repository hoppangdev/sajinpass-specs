{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sajinpass.com/specs/schema.json",
  "title": "사진패스 증명사진 규격",
  "description": "증명사진 규격 한 가지를 나타낸다. 규정 원문이 기준이며 이 데이터는 참고용이다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "audience",
    "photoMm",
    "headMm",
    "topMarginMm",
    "background",
    "expression",
    "checks",
    "digital",
    "print",
    "notes",
    "checkedAt"
  ],
  "properties": {
    "schemaVersion": {
      "description": "스키마 버전. 앱은 모르는 버전이면 내장 사본을 쓴다.",
      "const": 1
    },
    "id": {
      "description": "규격 식별자이자 파일 이름(확장자 제외).",
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z0-9-]+$"
    },
    "name": {
      "description": "화면에 보이는 규격 이름.",
      "type": "string",
      "minLength": 1
    },
    "official": {
      "description": "공식 규정이 있는 규격이면 true(기본). false면 발급 기관 규정이 없고 흔히 쓰는 크기를 담은 관습 규격이며, source를 생략할 수 있다.",
      "type": "boolean"
    },
    "unofficial": {
      "description": "공식 원문에 없어 사진패스가 정한 값. photoMm은 사진 크기, headMm은 머리 길이, background는 배경색이다. 화면에는 '사진패스 권장'으로 표시한다. 파일 픽셀·용량은 digital.unofficial에 적는다.",
      "type": "array",
      "items": {
        "enum": [
          "photoMm",
          "headMm",
          "background"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "audience": {
      "description": "대상. 영유아 규격은 입 벌림 점검을 건너뛴다.",
      "enum": [
        "adult",
        "infant"
      ]
    },
    "photoMm": {
      "description": "사진 크기 [가로, 세로] mm.",
      "$ref": "#/$defs/positivePair"
    },
    "headMm": {
      "description": "턱 끝에서 머리 꼭대기(headTop)까지 길이(mm). target은 자르기 배율을 정한다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "target"
      ],
      "properties": {
        "min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "target": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "headTop": {
      "description": "머리 길이를 재는 위쪽 끝. crown(기본)은 머리카락을 뺀 정수리, hair는 머리카락 끝이다(미국 비자처럼 머리카락까지 재는 규격).",
      "enum": [
        "crown",
        "hair"
      ]
    },
    "topMarginMm": {
      "description": "머리 꼭대기(headTop)에서 사진 위 가장자리까지 거리(mm).",
      "type": "number",
      "minimum": 0
    },
    "faceWidthMm": {
      "description": "종이 사진의 얼굴 폭(양 볼 바깥선 사이, mm). 원문에 있는 규격만 둔다. 자를 때 이 안에 들게 머리 길이를 고르고 얼굴 배치 점검이 본다.",
      "$ref": "#/$defs/positivePair"
    },
    "background": {
      "description": "배경 점검 기준. 밝기는 0~255.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "minLuma",
        "maxStd"
      ],
      "properties": {
        "kind": {
          "enum": [
            "white",
            "light"
          ]
        },
        "minLuma": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        },
        "maxStd": {
          "type": "number",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "expression": {
      "description": "표정 요구 사항.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mouthOpen",
        "smile",
        "eyesOpen"
      ],
      "properties": {
        "mouthOpen": {
          "description": "입 벌림 허용 여부.",
          "type": "boolean"
        },
        "smile": {
          "description": "미소 허용 여부.",
          "type": "boolean"
        },
        "eyesOpen": {
          "description": "눈을 떠야 하는지 여부.",
          "type": "boolean"
        }
      }
    },
    "checks": {
      "description": "켜고 끄는 자동 점검과 본인 확인 항목.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "faceCount",
        "headLength",
        "resolution",
        "sharpness",
        "tilt",
        "expression",
        "background",
        "shadow",
        "manual"
      ],
      "properties": {
        "faceCount": {
          "type": "boolean"
        },
        "headLength": {
          "type": "boolean"
        },
        "resolution": {
          "type": "boolean"
        },
        "sharpness": {
          "type": "boolean"
        },
        "tilt": {
          "type": "boolean"
        },
        "expression": {
          "type": "boolean"
        },
        "background": {
          "type": "boolean"
        },
        "shadow": {
          "type": "boolean"
        },
        "manual": {
          "description": "사용자가 직접 확인하는 항목.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "crownLine",
              "hairLine",
              "aloneInPhoto",
              "glasses",
              "noGlasses",
              "lenses",
              "takenWithin6Months"
            ]
          }
        }
      }
    },
    "digital": {
      "description": "온라인 제출 파일 규격.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "px",
        "wRange",
        "hRange",
        "format",
        "maxKB",
        "dpi"
      ],
      "properties": {
        "px": {
          "description": "내보내는 크기 [가로, 세로] px.",
          "$ref": "#/$defs/positiveIntPair"
        },
        "wRange": {
          "description": "허용 가로 범위 [최소, 최대] px.",
          "$ref": "#/$defs/positiveIntPair"
        },
        "hRange": {
          "description": "허용 세로 범위 [최소, 최대] px.",
          "$ref": "#/$defs/positiveIntPair"
        },
        "format": {
          "enum": [
            "jpeg"
          ]
        },
        "accept": {
          "description": "제출처가 받는 파일 형식. 없으면 format만 받는다. 사진패스가 만드는 파일은 늘 format이다.",
          "type": "array",
          "items": {
            "enum": [
              "jpeg",
              "png",
              "gif"
            ]
          },
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "const": "jpeg"
          }
        },
        "maxKB": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "frameMm": {
          "description": "파일이 담는 범위 [가로, 세로] mm. 파일 비율이 종이 사진(photoMm)과 다른 규격만 둔다. 높이는 photoMm과 같고 가로는 같거나 넓다. 인화는 가운데를 photoMm 비율로 잘라 쓴다.",
          "$ref": "#/$defs/positivePair"
        },
        "minKB": {
          "description": "제출처가 정한 최소 용량(KB). 없으면 하한이 없다. maxKB보다 작다.",
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "layout": {
          "description": "제출처가 파일 픽셀로 정한 얼굴 배치. refPx 크기 파일 기준이고 다른 크기면 가로 비율로 늘린다. faceWidthPx는 얼굴 폭 범위, eyeFromBottomMinPx는 파일 아래 끝에서 눈 가운데 선까지의 최소 거리, eyeDistanceMinPx는 두 눈 사이 최소 거리, crownFromTopPx는 파일 위 끝에서 머리 꼭대기(headTop)까지의 거리 범위.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "refPx",
            "faceWidthPx",
            "eyeFromBottomMinPx",
            "eyeDistanceMinPx",
            "crownFromTopPx"
          ],
          "properties": {
            "refPx": {
              "$ref": "#/$defs/positivePair"
            },
            "faceWidthPx": {
              "$ref": "#/$defs/positivePair"
            },
            "eyeFromBottomMinPx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "eyeDistanceMinPx": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "crownFromTopPx": {
              "$ref": "#/$defs/positivePair"
            }
          }
        },
        "dpi": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "unofficial": {
          "description": "공식 원문에 없어 사진패스가 정한 값. px는 크기(와 허용 범위), maxKB는 용량, dpi는 파일에 적는 해상도(파일 검사기가 점검하지 않는다). 없으면 모두 원문 값이다. 화면에는 '사진패스 권장'으로 표시한다.",
          "type": "array",
          "items": {
            "enum": [
              "px",
              "maxKB",
              "dpi"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "print": {
      "description": "인화 배치. sheetPx는 dpi(없으면 300) 기준.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheetIn",
        "sheetPx",
        "cols",
        "rows",
        "cutLines"
      ],
      "properties": {
        "sheetIn": {
          "description": "인화지 크기 [가로, 세로] inch.",
          "$ref": "#/$defs/positivePair"
        },
        "sheetPx": {
          "description": "인화지 크기 [가로, 세로] px.",
          "$ref": "#/$defs/positiveIntPair"
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "cutLines": {
          "type": "boolean"
        },
        "dpi": {
          "description": "선택. 인화지 해상도. 없으면 300. 원문이 더 높은 인화 해상도를 요구하면(독일 600dpi) 적는다.",
          "type": "integer",
          "exclusiveMinimum": 0
        }
      }
    },
    "allowedFixes": {
      "description": "규정 안에서 도구가 자동으로 고쳐도 되는 것. 없으면 자르기·크기 조정·압축만 한다. 배경·밝기·피부는 규격과 상관없이 자동으로 고치지 않는다(배경 단색·밝기는 사용자가 켤 때만 도구가 한다).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rotate": {
          "description": "두 눈을 잇는 선의 기울기가 maxDeg(도) 이하이면 그만큼 돌려 바로 세운 뒤 자른다. 넘으면 고치지 않고 다시 찍기를 안내한다.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxDeg"
          ],
          "properties": {
            "maxDeg": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 15
            }
          }
        }
      }
    },
    "poseMaxDeg": {
      "description": "원문이 허용하는 고개 각도(도). 있으면 공통 기준(기울기 6°, 정면 15°)을 넘어도 이 안이면 실패 대신 주의로 둔다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roll",
        "yaw",
        "pitch"
      ],
      "properties": {
        "roll": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "yaw": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pitch": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "notes": {
      "description": "언어별 한 줄 요약.",
      "type": "object",
      "required": [
        "ko"
      ],
      "properties": {
        "ko": {
          "type": "string",
          "minLength": 1
        }
      },
      "propertyNames": {
        "pattern": "^[a-z]{2}$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "description": "규정 원문 링크.",
      "type": "string",
      "pattern": "^https://"
    },
    "sourceDigital": {
      "description": "전자 제출 규정 원문 링크.",
      "type": "string",
      "pattern": "^https://"
    },
    "checkedAt": {
      "description": "원문을 마지막으로 확인한 날짜(YYYY-MM-DD).",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "$defs": {
    "positivePair": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "items": false,
      "minItems": 2
    },
    "positiveIntPair": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        {
          "type": "integer",
          "exclusiveMinimum": 0
        }
      ],
      "items": false,
      "minItems": 2
    }
  },
  "if": {
    "properties": {
      "official": {
        "const": false
      }
    },
    "required": [
      "official"
    ]
  },
  "else": {
    "properties": {
      "source": true
    },
    "required": [
      "source"
    ]
  }
}
